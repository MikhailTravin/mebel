                            </h2>
                            <a href="./" class="link">
                                <span>Смотреть все проекты</span>
                                <svg aria-hidden="true" width="16" height="9">
                                    <use xlink:href="img/sprite.svg#arrow1"></use>
                                </svg>
                            </a>
                        </div>
                        <div class="block-project__cards">
                            <a href="./" class="card-project">
                                <img loading="lazy" src="img/catalog/image3.webp" alt="" class="card-project__pic1">
                                <div class="card-project__item">
                                    <div class="card-project__titles">
                                        <div class="card-project__title">
                                            PRIVATE RESIDENCE
                                        </div>
                                        <p>
                                            Москва, 2024
                                        </p>
                                    </div>
                                    <div class="icon-arrow">
                                        <svg aria-hidden="true" width="16" height="9">
                                            <use xlink:href="img/sprite.svg#arrow1"></use>
                                        </svg>
                                    </div>
                                </div>
                            </a>
                            <a href="./" class="card-project">
                                <img loading="lazy" src="img/catalog/image5.webp" alt="" class="card-project__pic1">
                                <div class="card-project__item">
                                    <div class="card-project__titles">
                                        <div class="card-project__title">
                                            АПАРТАМЕНТЫ НА ПАТРИКАХ
                                        </div>
                                        <p>
                                            Москва, 2024
                                        </p>
                                    </div>
                                    <div class="icon-arrow">
                                        <svg aria-hidden="true" width="16" height="9">
                                            <use xlink:href="img/sprite.svg#arrow1"></use>
                                        </svg>
                                    </div>
                                </div>
                            </a>
                            <a href="./" class="card-project">
                                <img loading="lazy" src="img/catalog/image2.webp" alt="" class="card-project__pic1">
                                <div class="card-project__item">
                                    <div class="card-project__titles">
                                        <div class="card-project__title">
                                            РЕЗИДЕНЦИЯ В ПОДМОСКОВЬЕ
                                        </div>
                                        <p>
                                            Московская область, 2023
                                        </p>
                                    </div>
                                    <div class="icon-arrow">
                                        <svg aria-hidden="true" width="16" height="9">
                                            <use xlink:href="img/sprite.svg#arrow1"></use>
                                        </svg>
                                    </div>
                                </div>
                            </a>
                            <a href="./" class="card-project">
                                <img loading="lazy" src="img/catalog/image1.webp" alt="" class="card-project__pic1">
                                <div class="card-project__item">
                                    <div class="card-project__titles">
                                        <div class="card-project__title">
                                            ПЕНТХАУС НА ОСТОЖЕНКЕ
                                        </div>
                                        <p>
                                            Москва, 2023
                                        </p>
                                    </div>
                                    <div class="icon-arrow">
                                        <svg aria-hidden="true" width="16" height="9">
                                            <use xlink:href="img/sprite.svg#arrow1"></use>
                                        </svg>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/popups.njk' %}
    {% include 'blocks/scripts.njk' %}
</body>

</html>
<!DOCTYPE html>
<html lang="ru">

<head>
    <title>Категория</title>
    {% include 'blocks/head.njk' %}
</head>

<body class="preload mp">
    <div class="main-wrapper-outer">
        {% include 'blocks/header.njk' %}
        <main class="main">

            <div class="block-intro block-intro-other">
                <div class="container">
                    <div class="block-intro__content">
                        <div class="breadcrumbs">
                            <ul>
                                <li>
                                    <a href="#" class="home">
                                        <img src="img/icons/home.svg" alt="">
                                    </a>
                                </li>
                                <li><a href="./">Проекты</a></li>
                                <li><span>Кухня в ЖК “Садовые кварталы”</span></li>
                            </ul>
                        </div>
                        <div class="block-intro__top">
                            <h1 class="title1">
                                Кухня-гостиная<br> в ЖК “Садовые кварталы”
                            </h1>
                        </div>
                        <div class="block-intro__buttons">
                            <a href="./" data-popup="#call" class="btn">
                                <img src="img/icons/calculator.svg" alt="">
                                <span>Получить расчет</span>
                            </a>
                            <a href="./" class="btn btn-white">
                                <div class="btn__icon icon-construktor">
                                    <svg aria-hidden="true" width="18" height="18">
                                        <use xlink:href="img/sprite.svg#construktor"></use>
                                    </svg>
                                </div>
                                <span>AI-конструктор интерьера</span>
                            </a>
                        </div>
                        <div class="block-intro-descr">
                            <div class="block-intro-descr__column">
                                <div class="block-intro-descr__icon">
                                    <img src="img/icons/pin.svg" alt="">
                                </div>
                                <div class="block-intro-descr__item">
                                    <p>
                                        Москва
                                    </p>
                                </div>
                            </div>
                            <div class="block-intro-descr__column">
                                <div class="block-intro-descr__icon">
                                    <img src="img/icons/car.svg" alt="">
                                </div>
                                <div class="block-intro-descr__item">
                                    <p>
                                        Доставка по всей России
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <img src="img/bg3.webp" alt="" class="block-intro__bg1">
            </div>

            <div class="block-project block3">
                <div class="container">
                    <div class="block-project__content">

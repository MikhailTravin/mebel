<div id="call" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <svg aria-hidden="true" width="8" height="8">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </div>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="popup-forms__title">
                        Получить расчет
                    </div>
                </div>
                <form data-popup-message="#thanks" action="#" data-dev class="form">
                    <div class="form__body">
                        <div class="form__inputs">
                            <div class="form__input">
                                <input data-required autocomplete="off" type="text" name="name1" placeholder="Ваше имя"
                                    class="input">
                            </div>
                            <div class="form__input">
                                <input data-required autocomplete="off" type="text" name="phone1" placeholder="Телефон"
                                    class="input">
                            </div>
                            <div class="form__input">
                                <select name="select1" class="select">
                                    <option value="" data-show data-label data-label="Тип мебели:" selected>
                                        Тип мебели
                                    </option>
                                    <option value="1">Пункт №1</option>
                                    <option value="2">Пункт №2</option>
                                    <option value="3">Пункт №3</option>
                                    <option value="4">Пункт №4</option>
                                </select>
                            </div>
                            <div class="form__input">
                                <div class="form-file">
                                    <input type="file">
                                    <div class="form-file__icon">
                                        <svg aria-hidden="true" width="30" height="27">
                                            <use xlink:href="img/sprite.svg#cloud"></use>
                                        </svg>
                                    </div>
                                    <div class="form-file__titles">
                                        <div class="form-file__title">
                                            Загрузите фото вашего помещения
                                        </div>
                                        <p>
                                            JPG, PNG до 10 МБ
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form__bottom">
                            <div class="form__input">
                                <textarea placeholder="Комментарий к проекту" class="input textarea"></textarea>
                            </div>
                            <div class="form__buttons">
                                <button type="submit" class="btn">
                                    <span>Отправить заявку</span>
                                    <div class="btn__icon">
                                        <svg aria-hidden="true" width="16" height="9">
                                            <use xlink:href="img/sprite.svg#arrow1"></use>
                                        </svg>
                                    </div>
                                </button>
                                <div class="form__text">
                                    Нажимая на кнопку вы соглашаетесь с <a href="./">политикой конфиденциальности</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="thanks" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <svg aria-hidden="true" width="8" height="8">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </div>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="popup-forms__title">Спасибо за заявку!</div>
                    <p>
                        Свяжимся с вами в ближайшее время.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
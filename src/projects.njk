                                            </div>
                                            <p>
                                                Москва - 42 м2 - Шпон дуба, камень, матовая эмаль
                                            </p>
                                        </div>
                                        <div class="icon-arrow">
                                            <svg aria-hidden="true" width="16" height="9">
                                                <use xlink:href="img/sprite.svg#arrow1"></use>
                                            </svg>
                                        </div>
                                    </div>
                                </a>
                                <a data-filter="filter8" href="./" class="card-project filter-card">
                                    <img loading="lazy" src="img/catalog/image2.webp" alt="" class="card-project__pic1">
                                    <div class="card-project__item">
                                        <div class="card-project__titles">
                                            <div class="card-project__title">
                                                Кухня в загородном доме
                                            </div>
                                            <p>
                                                Московская область - 28 м2 - Натуральный шпон, камень
                                            </p>
                                        </div>
                                        <div class="icon-arrow">
                                            <svg aria-hidden="true" width="16" height="9">
                                                <use xlink:href="img/sprite.svg#arrow1"></use>
                                            </svg>
                                        </div>
                                    </div>
                                </a>
                                <a data-filter="filter9" href="./" class="card-project filter-card">
                                    <img loading="lazy" src="img/catalog/image1.webp" alt="" class="card-project__pic1">
                                    <div class="card-project__item">
                                        <div class="card-project__titles">
                                            <div class="card-project__title">
                                                Гардеробная комната
                                            </div>
                                            <p>
                                                Москва - 12 м2 - Шпон ореха, стекло, металл
                                            </p>
                                        </div>
                                        <div class="icon-arrow">
                                            <svg aria-hidden="true" width="16" height="9">
                                                <use xlink:href="img/sprite.svg#arrow1"></use>
                                            </svg>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            <button type="button" class="btn btn-white">
                                <div class="btn__icon icon-refresh">
                                    <svg aria-hidden="true" width="16" height="16">
                                        <use xlink:href="img/sprite.svg#refresh"></use>
                                    </svg>
                                </div>
                                <span>Показать еще проекты</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="block-required2 block-required-projects block3">
                <div class="container">
                    <div class="block-required2__content">
                        <img loading="lazy" src="img/image11.webp" alt="" class="block-required2__pic1">
                        <div class="heading-complex2">
                            <h2 class="title2">
                                Хотите интерьер
                                такого же уровня?
                            </h2>
                            <p>
                                Расскажите о помещении — подготовим концепцию и предварительный расчёт проекта
                            </p>
                        </div>
                        <div class="block-required2__body">
                            <div class="card-section">
                                <div class="card-section__icon">
                                    <img src="img/icons/tick2.svg" alt="">
                                </div>
                                <p>
                                    Персональный подход
                                    к вашему проекту
                                </p>
                            </div>
                            <div class="card-section">
                                <div class="card-section__icon">
                                    <img src="img/icons/calculator2.svg" alt="">
                                </div>
                                <p>
                                    Оптимальные решения
                                    и точный расчёт
                                </p>
                            </div>
                            <div class="card-section">
                                <div class="card-section__icon">
                                    <img src="img/icons/pro.svg" alt="">
                                </div>
                                <p>
                                    Производство и монтаж
                                    под ключ
                                </p>
                            </div>
                        </div>
                        <div class="block-required2__right">
                            <a href="./" data-popup="#call" class="btn">
                                <img src="img/icons/calculator.svg" alt="">
                                <span>Получить расчет</span>
                            </a>
                            <a href="./" class="btn btn-white">
                                <div class="btn__icon icon-construktor">
                                    <svg aria-hidden="true" width="18" height="18">
                                        <use xlink:href="img/sprite.svg#construktor"></use>
                                    </svg>
                                </div>
                                <span>AI-конструктор интерьера</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/popups.njk' %}
    {% include 'blocks/scripts.njk' %}
</body>

</html>
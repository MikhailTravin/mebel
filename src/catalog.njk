                                    <svg aria-hidden="true" width="16" height="9">
                                        <use xlink:href="img/sprite.svg#arrow1"></use>
                                    </svg>
                                </div>
                            </a>
                        </div>
                        <div data-ba class="before-after">
                            <div data-ba-before class="before-after__item">
                                <img loading="lazy" src="img/image1.webp" alt="">
                            </div>
                            <div data-ba-after class="before-after__item">
                                <img loading="lazy" src="img/image2.webp" alt="">
                            </div>
                            <div data-ba-arrow class="before-after__arrows">
                            </div>
                        </div>
                        <div class="block-constructor-steps">
                            <div class="block-constructor-steps__column">
                                <div class="block-constructor-steps__item">
                                    <img loading="lazy" src="img/image3.webp" alt=""
